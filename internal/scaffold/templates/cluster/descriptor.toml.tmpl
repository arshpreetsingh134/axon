# {{.File}} — the CLUSTER descriptor. Every member app is a sibling directory of this
# controller dir with its own {{.File}} (build_type = app | module | project).
# `axon up --build` reconciles everything declared here; `axon cluster check` validates it.
build_type = "cluster"

name    = "{{.Name}}"            # compose project prefix and Kubernetes namespace stem
network = "{{.Name}}-net"        # shared docker network (axon creates it)
domain  = "lvh.me"               # apps answer at <host>.<domain>; lvh.me resolves to 127.0.0.1
{{if .CoreImage}}core_image = "{{.CoreImage}}"   # every app core is assembled FROM this image
{{else}}# core_image = "<registry>/<core image>:<tag>"   # REQUIRED before the first deploy
{{end}}
# ── Shared fabric ────────────────────────────────────────────────────────────
[fabric.postgres]
image = "postgres:16-alpine"
port  = {{.Ports.Postgres}}       # host port (allocated free on this machine by `axon cluster new`)

# Temporal (for workflow workers). Remove this table if no app uses Temporal.
[fabric.temporal]
image   = "temporalio/auto-setup:1.25.2"
shards  = 128                   # NUM_HISTORY_SHARDS — fixed once Temporal initializes
port    = {{.Ports.Temporal}}
ui_port = {{.Ports.TemporalUI}}

# Keycloak, the identity provider the cluster's IAM app brokers OIDC through.
[fabric.keycloak]
image  = "quay.io/keycloak/keycloak:25.0"
realm  = "{{.Name}}"
client = "{{.Name}}-iam"
secret = "${OIDC_CLIENT_SECRET}"  # resolved from .axon.infra/.env
admin_email = "admin@{{.Name}}.local"

# The single front door (host-name routing for every app).
[fabric.traefik]
http = {{.Ports.Traefik}}

# Distributed tracing: Tempo + Grafana. Remove this table to disable tracing.
[fabric.tracing]
tempo_image   = "grafana/tempo:2.6.1"
grafana_image = "grafana/grafana:11.3.0"
grafana_port  = {{.Ports.Grafana}}

# Business-event store for the kpi module. Enable with `axon cluster add fabric clickhouse`.
# [fabric.clickhouse]
# image     = "clickhouse/clickhouse-server:24.8"
# http_port = {{.Ports.Clickhouse}}
# database  = "axon_kpi"

# Identity contract every core verifies tokens against.
[fabric.iam]
issuer      = "{{.Name}}"
audience    = "{{.Name}}-app"
backend     = "mycel_iam:7373"
signing_key = "{{.Infra}}/secrets/iam_signing_key.pem"   # ES256, generated by axon, gitignored

# ── Lifecycle hooks (optional) ───────────────────────────────────────────────
# Commands run from this directory around `axon up` / `axon env deploy`.
# [hooks]
# pre_build   = ["{{.Infra}}/scripts/link-sources.sh"]
# post_deploy = ["{{.Infra}}/scripts/smoke.sh"]

# ── Member apps ──────────────────────────────────────────────────────────────
# Add them with `axon cluster add app`, e.g.
#   axon cluster add app --name {{.Name}}.iam --kind iam --from-image <img> --token mycel_iam --host iam --db iam
#   axon cluster add app --name {{.Name}}.web --from ../{{.Name}}.web --host web --db web
