# Standalone image for the {{.Token}} module server (axon builds a thinner image by
# compiling on the host; this file is for building without axon).
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY service/ ./service/
RUN cd service && go mod download
RUN cd service && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/server .

FROM alpine:3
WORKDIR /app
COPY --from=build /out/server /app/server
ENV MYCEL_LISTEN=0.0.0.0:7373
EXPOSE 7373
USER 65532
ENTRYPOINT ["/app/server"]
