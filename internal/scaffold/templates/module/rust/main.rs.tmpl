//! The {{.Token}} module server. The core host dials it on MYCEL_LISTEN
//! (default 0.0.0.0:7373) inside the cluster.
use std::io::{Read, Write};
use std::net::TcpListener;

fn greeting(name: &str) -> String {
    let n = name.trim();
    format!("Hello, {}!", if n.is_empty() { "{{.Title}}" } else { n })
}

fn main() -> std::io::Result<()> {
    let addr = std::env::var("MYCEL_LISTEN").unwrap_or_else(|_| "127.0.0.1:7373".into());
    let listener = TcpListener::bind(&addr)?;
    eprintln!("{{.Token}} listening on {addr}");
    for stream in listener.incoming() {
        let mut s = stream?;
        let mut buf = [0u8; 2048];
        let _ = s.read(&mut buf);
        let body = format!("{{"{{"}}\"message\":\"{}\"{{"}}"}}", greeting(""));
        let resp = format!("HTTP/1.1 200 OK\r\ncontent-type: application/json\r\ncontent-length: {}\r\n\r\n{}", body.len(), body);
        let _ = s.write_all(resp.as_bytes());
    }
    Ok(())
}

#[cfg(test)]
mod tests {
    use super::greeting;
    #[test]
    fn greets() {
        assert_eq!(greeting("Ada"), "Hello, Ada!");
        assert_eq!(greeting(" "), "Hello, {{.Title}}!");
    }
}
