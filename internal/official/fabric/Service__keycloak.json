{
 "apiVersion": "v1",
 "kind": "Service",
 "metadata": {
  "annotations": {},
  "name": "keycloak",
  "namespace": "{{NAMESPACE}}"
 },
 "spec": {
  "ports": [
   {
    "name": "http",
    "port": 8080,
    "targetPort": 8080
   },
   {
    "name": "management",
    "port": 9000,
    "targetPort": 9000
   }
  ],
  "selector": {
   "app": "keycloak"
  }
 }
}
