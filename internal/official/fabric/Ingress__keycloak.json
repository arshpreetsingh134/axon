{
 "apiVersion": "networking.k8s.io/v1",
 "kind": "Ingress",
 "metadata": {
  "annotations": {
   "traefik.ingress.kubernetes.io/router.entrypoints": "web,websecure"
  },
  "name": "keycloak",
  "namespace": "{{NAMESPACE}}"
 },
 "spec": {
  "ingressClassName": "traefik",
  "rules": [
   {
    "host": "keycloak.{{DOMAIN}}",
    "http": {
     "paths": [
      {
       "backend": {
        "service": {
         "name": "keycloak",
         "port": {
          "number": 8080
         }
        }
       },
       "path": "/",
       "pathType": "Prefix"
      }
     ]
    }
   }
  ]
 }
}
