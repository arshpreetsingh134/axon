{
 "apiVersion": "v1",
 "kind": "Service",
 "metadata": {
  "annotations": {
   "service.beta.kubernetes.io/azure-load-balancer-resource-group": "{{RESOURCE_GROUP}}",
   "service.beta.kubernetes.io/azure-pip-name": "{{FRONTEND_NAME}}"
  },
  "name": "traefik",
  "namespace": "{{NAMESPACE}}"
 },
 "spec": {
  "ports": [
   {
    "name": "https",
    "port": 443,
    "targetPort": 8443
   }
  ],
  "selector": {
   "app": "traefik"
  },
  "type": "LoadBalancer"
 }
}
